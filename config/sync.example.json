{
  "source_root": "@SOURCE_ROOT@",
  "markdown_root": "@RUNTIME_ROOT@/markdown",
  "weknora_base_url": "http://127.0.0.1:8090",
  "knowledge_base_id": "@KB_ID@",
  "knowledge_base_name": "全部售前文档",
  "folder_root": "项目to咨询",
  "api_key_file": "@RUNTIME_ROOT@/private/api-key.txt",
  "required_capabilities": [
    "retrieve",
    "ingest"
  ],
  "automatic_deletion_enabled": false,
  "watch_enabled": false,
  "state_dir": "@RUNTIME_ROOT@/sync",
  "baseline_mapping": "@RUNTIME_ROOT@/baseline.json",
  "interval_seconds": 60,
  "stable_seconds": 180,
  "delete_grace_seconds": 60,
  "max_jobs_per_cycle": 6,
  "reuse_robot1_artifacts": false,
  "llm_enabled": true,
  "model_secrets_file": "@RUNTIME_ROOT@/private/model-env.json",
  "parser_config": {
    "model": "qwen3.8-flash",
    "model_review": false,
    "parser_prompt": "@RELEASE_ROOT@/提示词/通用文档解析提示词_v3.1.md",
    "evaluation_prompt": "@RELEASE_ROOT@/提示词/评测集生成提示词.md",
    "soffice": "@SOFFICE@",
    "pdftoppm": "@PDFTOPPM@",
    "local_ocr_python": null
  },
  "excluded_sources": {
    "P 巴拿马/巴拿马购房移民PR/9、培训/巴拿马项目CRS卖点/巴拿马6月介绍版.pptx": "用户此前明确跳过",
    "S 新加坡/2、新加坡自雇EP/新加坡EP成功案例/新加坡超全宣传素材-销售/新加坡教育/新加坡国际私立学校最新学费一览.pdf": "图片资产未适配",
    "S 西班牙/西班牙非盈利移民/8、房源介绍/已售罄/20180802 非盈利房源 15w左右 阿利坎特/15万-阿利坎特萨顿公寓.Ap20180529a.pdf": "用户此前明确跳过",
    "U 英国/英国杰出人才签证GTV/2、项目介绍（PPT、折页）/英国全球杰出人才签证介绍.pdf": "用户此前明确跳过",
    "测试/恢复验证_20261014_120456/同步恢复验证.docx": "退出重开恢复验收专用虚构文档，禁止业务入库",
    "S 新加坡/2、新加坡自雇EP/新加坡EP成功案例/新加坡超全宣传素材-销售/新加坡教育/新加坡国际学校图片合集/伊顿幼儿园8.jpg": "用户明确排除：现场照片，分区解析后无可用正文；保留原图和历史记录，不入库"
  },
  "allow_model_calls": false,
  "model_authorization": "Enable explicitly after validating the deployment",
  "delete_missing_scans": 3,
  "failure_notifications": {
    "enabled": true,
    "desktop": false
  },
  "operational_logging": {
    "enabled": true
  },
  "mass_missing_protection_enabled": true,
  "pdf_auto_compatibility_enabled": true,
  "pdf_compatibility_python": "@PYTHON@",
  "parser_skip_extensions": [
    ".csv",
    ".xlsx",
    ".xls"
  ],
  "direct_migration_jobs_per_cycle": 24,
  "table_docreader_container": "WeKnora-docreader",
  "table_docker_binary": "/Applications/Docker.app/Contents/Resources/bin/docker"
}
