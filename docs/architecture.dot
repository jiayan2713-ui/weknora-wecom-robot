digraph architecture {
graph [rankdir=TB, compound=true, nodesep=0.35, ranksep=0.65, pad=0.35, bgcolor="white", fontname="Arial", label="WeKnora 企微机器人5 · 本地与外部服务架构", labelloc=t, fontsize=24];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#64748b", fontname="Arial", fontsize=14, margin="0.22,0.14"];
edge [color="#64748b", fontcolor="#334155", fontname="Arial", fontsize=11, arrowsize=0.65];
subgraph cluster_EXT { label="外部服务 / 云端"; style="rounded,filled"; color="#94a3b8"; fillcolor="#eef2ff"; fontsize=18; margin=22;
WD [label="企业微信微盘云端\n业务原始资料"];
WX [label="企业微信机器人服务\n员工单聊 / 群聊入口"];
MODEL [label="外部模型 API\n回答 / 解析 / 图片理解\nDeepSeek、DashScope 等"];
ER [label="Embedding / Rerank API\ntext-embedding-v4\nqwen3.7-text-rerank"];
SPEECH [label="百炼语音 API\nqwen-audio-3.0-asr-flash"];
WEB [label="Keenable 联网搜索\n已配置；当前 Agent 关闭"];
CRM [label="明道云 · 移民 CRM\n上线后真实问答\n原始答案 / 网页答案 / 人工评测"];
}
subgraph cluster_MAC { label="本地 Mac · 当前主机"; style="rounded,filled"; color="#94a3b8"; fillcolor="#f8fafc"; fontsize=18; margin=22;
subgraph cluster_HOST { label="macOS 客户端、5个后台任务与本地数据"; style="rounded,filled"; color="#94a3b8"; fillcolor="#f0fdf4"; fontsize=18; margin=22;
CLIENT [label="企微桌面客户端\n微盘同步进程"];
SOURCE [label="本地微盘原件\n项目to咨询", shape=cylinder];
WORKER [label="① 同步 worker\n扫描60秒 / 稳定等待180秒"];
PARSER [label="worker内解析模块 + docflow\n转换 / 渲染 / 模型解析\n完整性、预算与检查点"];
MD [label="Markdown\n当前解析结果", shape=cylinder];
STATE [label="状态与版本档案\n指纹 / 知识ID / 缓存 / 旧版备份", shape=cylinder];
COMP [label="② 每日压缩 03:00\n售前文档 >30MB"];
REC [label="③ 压缩恢复 / 120秒"];
ALERT [label="④ 异常检查 / 300秒"];
BACKUP [label="压缩原件备份\n候选文件 / 台账", shape=cylinder];
COLLECT [label="⑤ 问答采集 / 60秒\n同进程执行 CRM 同步"];
SQLITE [label="SQLite档案\n完整问答 / 版本 / CRM去重", shape=cylinder];
FORMAT [label="同进程网页排版\nMarkdown → HTML / 无模型调用"];
EXPORT [label="后台Excel导出子进程"];
FILES [label="JSON / Excel派生文件", shape=cylinder];
LOG [label="审计日志 / 失败与恢复清单", shape=cylinder];
OPS [label="LaunchAgent调度\nDocker Desktop / caffeinate"];
ADMIN [label="管理浏览器"];
}
subgraph cluster_DOCKER { label="Docker · 7个WeKnora容器"; style="rounded,filled"; color="#94a3b8"; fillcolor="#eff6ff"; fontsize=18; margin=22;
FRONT [label="frontend / :8090"];
APP [label="app / :8091\nAgent、索引、检索、企微渠道"];
DOC [label="docreader\n平台内部读取解析"];
PG [label="PostgreSQL\n文档、分块、索引、会话、消息", shape=cylinder];
REDIS [label="Redis\n缓存与异步协调", shape=cylinder];
NEO [label="Neo4j\n图谱；当前问答参与未验证", shape=cylinder];
ASR [label="bailian-asr\n本地协议适配"];
}
}
WD -> CLIENT [label="下载与变更同步"];
CLIENT -> SOURCE [label="原件落地"];
SOURCE -> WORKER [label="扫描 / 指纹 / 快照"];
WORKER -> PARSER [label="新版本需解析"];
PARSER -> MODEL [label="页面 / 图片与解析结果", dir=both];
PARSER -> MD [label="完整性通过"];
MD -> APP [label="worker上传 / 更新"];
WORKER -> APP [label="索引与检索验证 / 新版激活 / 旧版清理", dir=both];
WORKER -> STATE [label="持久化任务与映射", dir=both];
COMP -> BACKUP [label="先备份再生成候选"];
COMP -> SOURCE [label="受控读取回写 / 与worker协调文件锁", dir=both];
CLIENT -> COMP [label="客户端身份与版本核验"];
COMP -> STATE [label="版本台账"];
REC -> COMP [label="恢复未完成任务"];
ALERT -> BACKUP [label="只读检查"];
ADMIN -> FRONT [];
FRONT -> APP [label="管理API", dir=both];
WX -> APP [label="WebSocket：问题、附件 / 回答", dir=both];
APP -> MODEL [label="主回答deepseek-v4.1-flash / 视觉理解", dir=both];
APP -> ER [label="向量化 / 重排", dir=both];
APP -> DOC [label="平台解析任务", dir=both];
APP -> PG [label="知识、索引、会话消息读写", dir=both];
APP -> REDIS [label="缓存 / 异步任务", dir=both];
APP -> NEO [label="已部署；实际问答参与未验证", style=dashed];
APP -> ASR [label="按需音频转写", style=dashed];
ASR -> SPEECH [label="音频 / 文本", dir=both];
APP -> WEB [label="当前Agent关闭", style=dashed];
PG -> COLLECT [label="只读采集机器人5企微渠道"];
COLLECT -> SQLITE [label="原文、版本、游标保存"];
SQLITE -> COLLECT [label="直接读取，不经过Excel"];
COLLECT -> CRM [label="完整问答 / 执行记录；写后回读"];
COLLECT -> FORMAT [];
FORMAT -> CRM [label="网页HTML；写后回读"];
COLLECT -> EXPORT [label="触发导出"];
SQLITE -> EXPORT [label="一致性快照"];
EXPORT -> FILES [];
WORKER -> LOG [];
PARSER -> LOG [];
COMP -> LOG [];
ALERT -> LOG [];
COLLECT -> LOG [];
OPS -> WORKER [label="启动与调度", style=dashed];
OPS -> COLLECT [label="定时执行", style=dashed];
OPS -> COMP [label="定时执行", style=dashed];
OPS -> REC [label="定时执行", style=dashed];
OPS -> ALERT [label="定时执行", style=dashed];
OPS -> APP [label="容器运行承载", style=dashed];
WD WX MODEL ER SPEECH CRM [fillcolor="#e0e7ff"];
WORKER COMP REC ALERT COLLECT [fillcolor="#dcfce7"];
SOURCE MD STATE BACKUP SQLITE FILES LOG [fillcolor="#ffedd5"];
WEB NEO [fillcolor="#f3f4f6", style="rounded,filled,dashed"];
}
